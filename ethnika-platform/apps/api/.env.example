# Copier en .env (jamais commité). Toutes les variables sont validées au démarrage par src/config/env.ts.

NODE_ENV=development
PORT=4000

# PostgreSQL (docker compose up -d : base locale sur le port 15432)
DATABASE_URL=postgresql://ethnika:ethnika@localhost:15432/ethnika

# Secret partagé avec le site (en-tête X-Internal-Key), 32+ caractères : openssl rand -hex 32
# Doit être identique à API_INTERNAL_KEY dans apps/web/.env.local.
INTERNAL_API_KEY=

# Origines autorisées (CORS), séparées par des virgules : le site et le back-office uniquement.
CORS_ORIGINS=http://localhost:3000

# PDF (Puppeteer) : chemin du Chrome/Chromium du système. Docker : /usr/bin/chromium-browser.
CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# Adresse publique du site (liens dans les PDF et e-mails)
SITE_URL=http://localhost:3000

# Chiffrement applicatif (secrets 2FA…) : openssl rand -hex 32. À sauvegarder : sans elle, les 2FA sont à reconfigurer.
DATA_ENCRYPTION_KEY=

# Sessions du back-office (minutes)
SESSION_IDLE_MINUTES=30
SESSION_MAX_MINUTES=720

# E-mails : SMTP (smtp://utilisateur:motdepasse@hote:587). Vide = journalisés sans envoi.
SMTP_URL=
MAIL_FROM=ETHNIKA <contact@ethnikatour.com>
AGENCY_NOTIFY_EMAIL=

# Vols : mock (développement), duffel (jeton duffel_test_…) ou amadeus
FLIGHT_PROVIDER=mock
DUFFEL_TOKEN=
# Amadeus : https://test.api.amadeus.com (clés gratuites sur developers.amadeus.com), https://api.amadeus.com en production,
# ou le bac à sable simulé https://amadeus-api.mock.beeceptor.com (données aléatoires, réponses lentes : AMADEUS_TIMEOUT_MS=120000)
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_TIMEOUT_MS=30000

# Purge des demandes clôturées après N jours
LEAD_RETENTION_DAYS=730

# Paiements : none (liens désactivés) tant que l'agence n'a pas choisi son prestataire ; mock = simulation (interdite en production)
PAYMENT_PROVIDER=none

# Resend (prioritaire sur SMTP) : clé re_… ; le domaine de MAIL_FROM doit être vérifié dans Resend (SPF/DKIM)
RESEND_API_KEY=
