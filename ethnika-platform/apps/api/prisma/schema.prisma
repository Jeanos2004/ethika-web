// Base de données de l'API ETHNIKA (PostgreSQL). Migrations versionnées dans prisma/migrations.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum LeadType {
  contact
  billet
  circuit
  groupe
  pelerinage
  pro
}

enum LeadStatus {
  new
  in_progress
  confirmed
  cancelled
}

enum LeadEventKind {
  received
  ack_sent
  status_changed
  note
  exported
  assigned
  flight_hold
  payment_requested
  payment_received
}

/// Demande reçue du site (ou saisie par un agent).
model Lead {
  id             String          @id @default(uuid()) @db.Uuid
  /// Référence publique ETH-XXXXXX, communiquée au client.
  reference      String          @unique @db.VarChar(16)
  type           LeadType
  status         LeadStatus      @default(new)
  source         String          @default("site") @db.VarChar(16)
  fullName       String          @db.VarChar(120)
  phone          String          @db.VarChar(20)
  email          String?         @db.VarChar(200)
  locale         String          @default("fr") @db.VarChar(5)
  /// Détails propres au type (trajet, circuit, effectif…), validés par Zod avant écriture.
  details        Json
  message        String?         @db.Text
  /// Agent en charge (null = non attribuée).
  assignedToId   String?         @db.Uuid
  assignedTo     User?           @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  events         LeadEvent[]
  quotes         Quote[]
  flightBookings FlightBooking[]
  payments       Payment[]

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([assignedToId, status])
}

/// Historique d'une demande (journal d'audit fonctionnel).
model LeadEvent {
  id        String        @id @default(uuid()) @db.Uuid
  leadId    String        @db.Uuid
  lead      Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind      LeadEventKind
  /// Statut cible pour status_changed.
  status    LeadStatus?
  /// Auteur (identifiant agent en phase 2 ; « system » ou « site » sinon).
  actor     String        @default("system") @db.VarChar(64)
  note      String?       @db.Text
  createdAt DateTime      @default(now())

  @@index([leadId, createdAt])
}

/// Inscription aux alertes promo (double opt-in prévu avec le module mail).
model Subscriber {
  id                   String    @id @default(uuid()) @db.Uuid
  email                String    @unique @db.VarChar(200)
  locale               String    @default("fr") @db.VarChar(5)
  /// Empreinte SHA-256 du jeton de confirmation (double opt-in) ; null une fois confirmé.
  confirmTokenHash     String?   @unique @db.VarChar(64)
  confirmedAt          DateTime?
  /// Empreinte du jeton de désinscription (lien présent dans chaque e-mail).
  unsubscribeTokenHash String    @unique @db.VarChar(64)
  unsubscribedAt       DateTime?
  createdAt            DateTime  @default(now())
}

/**
 * ---------------------------- Back-office : comptes, sessions, audit ----------------------------
 */

enum Role {
  admin
  agent
}

/// Compte du back-office. Aucun compte par défaut : le premier admin est créé en ligne de commande.
model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique @db.VarChar(200)
  name               String    @db.VarChar(120)
  role               Role      @default(agent)
  /// Empreinte argon2id (jamais le mot de passe).
  passwordHash       String    @db.VarChar(255)
  /// Secret TOTP chiffré (AES-256-GCM, clé DATA_ENCRYPTION_KEY) ; null tant que la 2FA n'est pas configurée.
  totpSecret         String?   @db.VarChar(255)
  totpEnabled        Boolean   @default(false)
  /// Dernier pas TOTP accepté : un même code ne peut pas servir deux fois (rejeu).
  totpLastStep       Int?
  failedAttempts     Int       @default(0)
  lockCount          Int       @default(0)
  lockedUntil        DateTime?
  disabled           Boolean   @default(false)
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sessions           Session[]
  assignedLeads      Lead[]    @relation("LeadAssignee")
}

/// Session du back-office. Seule l'empreinte SHA-256 du jeton est stockée.
model Session {
  id          String   @id @db.VarChar(64)
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Vrai une fois le code TOTP vérifié (ou pour un agent sans 2FA).
  mfaVerified Boolean  @default(false)
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  expiresAt   DateTime
  ip          String?  @db.VarChar(64)
  userAgent   String?  @db.VarChar(255)

  @@index([userId])
  @@index([expiresAt])
}

/// Défi de connexion en deux étapes (mot de passe validé, code TOTP attendu). Courte durée, usage unique.
model LoginChallenge {
  id        String   @id @db.VarChar(64)
  userId    String   @db.Uuid
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Journal d'audit des actions sensibles (connexions, statuts, exports, comptes). Sans donnée personnelle de client.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String   @db.VarChar(64)
  target    String?  @db.VarChar(128)
  ip        String?  @db.VarChar(64)
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}

/**
 * ---------------------------- E-mails (file d'envoi) ----------------------------
 */

enum EmailStatus {
  pending
  sent
  failed
}

/// File d'envoi des e-mails (pattern outbox) : écrite dans la même transaction que la demande, envoyée par un worker avec reprises.
model EmailOutbox {
  id            String      @id @default(uuid()) @db.Uuid
  to            String      @db.VarChar(200)
  template      String      @db.VarChar(64)
  payload       Json
  status        EmailStatus @default(pending)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  lastError     String?     @db.VarChar(500)
  sentAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([status, nextAttemptAt])
}

/**
 * ---------------------------- Devis ----------------------------
 */

/// Devis rédigé par un agent pour une demande. Montants en unités entières de la devise (GNF sans décimales, EUR en centimes).
model Quote {
  id          String   @id @default(uuid()) @db.Uuid
  /// Numéro lisible, unique : DEV-2026-0001.
  number      String   @unique @db.VarChar(20)
  leadId      String   @db.Uuid
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  currency    String   @db.VarChar(3)
  /// Lignes { label, quantity, unitAmount } validées par Zod.
  lines       Json
  totalAmount BigInt
  validUntil  DateTime @db.Date
  notes       String?  @db.Text
  createdBy   String   @db.Uuid
  createdAt   DateTime @default(now())

  @@index([leadId, createdAt])
}

/**
 * ---------------------------- Contenus gérés depuis le back-office ----------------------------
 */

enum OfferType {
  vol
  pack
  last
}

/// Offre promotionnelle (page Offres). Textes FR/EN dans `i18n`, validés par Zod.
model Offer {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique @db.VarChar(80)
  type        OfferType
  /// { fr: { kicker, title, description, imageAlt }, en: { … } }
  i18n        Json
  imageUrl    String    @db.VarChar(300)
  /// Lien interne du site (ex. /billetterie?vers=CDG#demande).
  href        String    @db.VarChar(300)
  priceAmount BigInt?
  currency    String?   @db.VarChar(3)
  validUntil  DateTime? @db.Date
  published   Boolean   @default(false)
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, position])
}

/// Circuit (pages Circuits et fiche). Programme, inclus/non inclus et textes FR/EN dans `i18n` ; départs dans `departures`.
model Circuit {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique @db.VarChar(80)
  theme        String   @db.VarChar(20)
  region       String   @db.VarChar(20)
  durationDays Int
  imageUrl     String   @db.VarChar(300)
  priceFrom    BigInt?
  currency     String?  @db.VarChar(3)
  /// { fr: { title, headline, summary, place, imageAlt, intro, days: [...], included: [...], excluded: [...] }, en: { … } }
  i18n         Json
  /// [{ dates, status: available|last|request, price }]
  departures   Json
  published    Boolean  @default(false)
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, position])
}

/**
 * ---------------------------- Vols : options posées chez le fournisseur ----------------------------
 */

enum FlightBookingStatus {
  held
  confirmed
  cancelled
}

/// Option (PNR) posée chez le fournisseur par un agent. Les données des passagers restent chez le fournisseur.
model FlightBooking {
  id                 String              @id @default(uuid()) @db.Uuid
  provider           String              @db.VarChar(20)
  providerOrderId    String              @unique @db.VarChar(80)
  bookingReference   String?             @db.VarChar(20)
  status             FlightBookingStatus
  /// Montant décimal tel que renvoyé par le fournisseur (chaîne, jamais un flottant).
  totalAmount        String              @db.VarChar(20)
  currency           String              @db.VarChar(3)
  payBefore          DateTime?
  /// Trajet résumé (origine, destination, dates, compagnie) pour l'affichage, sans donnée personnelle.
  itinerary          Json
  passengerCount     Int
  leadId             String?             @db.Uuid
  lead               Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdBy          String              @db.Uuid
  /// Alerte d'échéance envoyée à l'agence (une seule fois).
  deadlineNotifiedAt DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status, payBefore])
  @@index([leadId])
}

/**
 * ---------------------------- Agence ----------------------------
 */

/// Coordonnées et mentions de l'agence (ligne unique, id = 1), modifiables par un administrateur.
/// Utilisées sur les PDF (récapitulatif, devis) ; tant qu'elles ne sont pas saisies, les placeholders […] restent visibles.
model AgencySettings {
  id                  Int      @id @default(1)
  address             String   @default("[Quartier], Conakry") @db.VarChar(200)
  phone               String   @default("+224 [NUMÉRO]") @db.VarChar(40)
  whatsapp            String   @default("") @db.VarChar(40)
  email               String   @default("contact@ethnikatour.com") @db.VarChar(200)
  licence             String   @default("[À COMPLÉTER]") @db.VarChar(80)
  rccm                String   @default("[À COMPLÉTER]") @db.VarChar(80)
  openingHours        String   @default("Lun – Sam · [HORAIRES]") @db.VarChar(200)
  /// Modalités de règlement imprimées sur les devis (comptes, Orange Money, espèces en agence…).
  paymentInstructions String   @default("Acompte à la confirmation, solde avant l'émission des billets. En agence (espèces, carte), par virement ou Orange Money : [COORDONNÉES À COMPLÉTER].") @db.Text
  /// Conditions rappelées sur les devis (renvoi aux CGV).
  quoteTerms          String   @default("Conditions générales de vente : [À COMPLÉTER].") @db.Text
  updatedBy           String?  @db.Uuid
  updatedAt           DateTime @updatedAt
}

/**
 * ---------------------------- Paiements ----------------------------
 */

enum PaymentStatus {
  pending
  paid
  failed
  cancelled
  expired
}

/// Paiement d'un devis, encaissé chez un prestataire (redirection : aucune donnée de carte ne transite par l'API).
/// Le client reçoit un lien /paiement/<reference>?t=<jeton> ; seul le hachage du jeton est stocké.
model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  /// Référence lisible : PAY-XXXXXX.
  reference   String        @unique @db.VarChar(16)
  leadId      String        @db.Uuid
  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quoteId     String?       @db.Uuid
  /// Unités entières de la devise (GNF, centimes d'euro).
  amount      BigInt
  currency    String        @db.VarChar(3)
  label       String        @db.VarChar(160)
  status      PaymentStatus @default(pending)
  provider    String        @db.VarChar(20)
  /// Identifiant de la transaction chez le prestataire (rapprochement, remboursement).
  providerRef String?       @db.VarChar(120)
  /// Moyen utilisé, tel que renvoyé par le prestataire (orange_money, card…).
  method      String?       @db.VarChar(40)
  tokenHash   String        @unique @db.VarChar(64)
  expiresAt   DateTime
  paidAt      DateTime?
  createdBy   String        @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([leadId])
}
