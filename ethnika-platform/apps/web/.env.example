# Copier en .env.local (jamais commité). Toutes les variables sont validées au démarrage par src/lib/env.ts.

# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Numéro WhatsApp au format international SANS "+" ni espaces (ex. 224620000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=224000000000

# Mode démonstration (présentation sans back-end, ex. Vercel) : 1 = bandeau démo, site non indexé,
# demandes gardées dans le navigateur et back-office de démo sur /admin. Vide ou 0 en production.
NEXT_PUBLIC_DEMO_MODE=

# --- Serveur uniquement (ne JAMAIS préfixer par NEXT_PUBLIC_) ---

# URL de l'API NestJS (phase 2). Vide = les formulaires sont validés puis journalisés côté serveur (mode maquette).
API_BASE_URL=
# Secret partagé web -> API (en-tête X-Internal-Key), 32+ caractères aléatoires : openssl rand -hex 32
API_INTERNAL_KEY=

# Anti-spam Cloudflare Turnstile (optionnel en dev)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
