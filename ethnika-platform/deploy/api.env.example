# Variables de production de l'API (copier en api.env, jamais commité). Détail : apps/api/.env.example.
NODE_ENV=production
PORT=4000
# Hôte « postgres » = service de docker-compose.prod.yml ; même mot de passe que postgres.env
DATABASE_URL=postgresql://ethnika:MOT_DE_PASSE@postgres:5432/ethnika
# openssl rand -hex 32 — identique à API_INTERNAL_KEY du site (Vercel)
INTERNAL_API_KEY=
# openssl rand -hex 32 — à sauvegarder hors du serveur : sans elle, les 2FA sont à reconfigurer
DATA_ENCRYPTION_KEY=
CORS_ORIGINS=https://ethnikatour.com,https://www.ethnikatour.com
SITE_URL=https://ethnikatour.com
SMTP_URL=
MAIL_FROM=ETHNIKA <contact@ethnikatour.com>
AGENCY_NOTIFY_EMAIL=
# Vols : mock, duffel (jeton duffel_test_… / duffel_live_…) ou amadeus
FLIGHT_PROVIDER=mock
DUFFEL_TOKEN=
# Amadeus : https://test.api.amadeus.com (clés developers.amadeus.com) puis https://api.amadeus.com en production
AMADEUS_BASE_URL=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_TIMEOUT_MS=30000
LEAD_RETENTION_DAYS=730
