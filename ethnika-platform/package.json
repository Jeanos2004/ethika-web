{
  "name": "ethnika-platform",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ethnika/web dev",
    "build": "pnpm --filter @ethnika/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @ethnika/web test:e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "audit:deps": "pnpm audit --prod"
  }
}
